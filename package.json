  },
  "devDependencies": {
    "@heroicons/react": "^2.2.0",
    "heroicons": "^2.2.0",
    "marked": "15.0.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shadcn": "4.21.3"
  }
