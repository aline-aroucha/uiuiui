{
  "name": "@aline-aroucha/uiuiui",
  "version": "0.1.0",
  "description": "UIUIUI design system: tokens, components and AI agent rules",
  "license": "MIT",
  "type": "module",
  "bin": {
    "uiuiui": "cli/uiuiui.mjs"
  },
  "files": [
