{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "uiuiui",
  "homepage": "https://aline-aroucha.github.io/uiuiui",
  "items": [
    {
      "name": "style",
      "type": "registry:style",
      "extends": "none",
      "title": "UIUIUI",
      "description": "The UIUIUI base: tokens (light and dark colors, radius, fonts), base styles and the cn() helper.",
      "dependencies": [
        "tw-animate-css",
        "clsx",
        "tailwind-merge",
        "@heroicons/react",
        "class-variance-authority"
      ],
      "registryDependencies": [
        "https://aline-aroucha.github.io/uiuiui/r/utils.json"
      ],
      "css": {
        "@import \"tw-animate-css\"": {},
        "@custom-variant dark (&:is(.dark *))": {},
        "@layer base": {
          "*": {
            "@apply border-border outline-ring/50": {}
          },
          "body": {
            "@apply bg-background text-foreground font-sans antialiased": {}
          }
        },
        "@utility glass": {
          "background-color": "var(--glass)",
          "-webkit-backdrop-filter": "blur(var(--glass-blur)) saturate(200%)",
          "backdrop-filter": "blur(var(--glass-blur)) saturate(200%)",
          "@media (prefers-reduced-transparency: reduce), (prefers-contrast: more)": {
            "background-color": "var(--glass-solid)",
            "-webkit-backdrop-filter": "none",
            "backdrop-filter": "none"
          }
        },
        "@utility glass-strong": {
          "background-color": "var(--glass-strong)",
          "-webkit-backdrop-filter": "blur(var(--glass-blur)) saturate(200%)",
          "backdrop-filter": "blur(var(--glass-blur)) saturate(200%)",
          "@media (prefers-reduced-transparency: reduce), (prefers-contrast: more)": {
            "background-color": "var(--glass-solid)",
            "-webkit-backdrop-filter": "none",
            "backdrop-filter": "none"
          }
        },
        "@utility glass-clear": {
          "background-color": "var(--glass-clear)",
          "color": "var(--glass-clear-foreground)",
          "-webkit-backdrop-filter": "blur(var(--glass-blur)) saturate(200%)",
          "backdrop-filter": "blur(var(--glass-blur)) saturate(200%)",
          "@media (prefers-reduced-transparency: reduce), (prefers-contrast: more)": {
            "background-color": "var(--glass-clear-solid)",
            "-webkit-backdrop-filter": "none",
            "backdrop-filter": "none"
          }
        },
        "@utility scroll-edge": {
          "mask-image": "linear-gradient(to bottom, transparent, black 24px, black calc(100% - 24px), transparent)"
        }
      },
      "cssVars": {
        "theme": {
          "radius-sm": "calc(var(--radius) - 4px)",
          "radius-md": "calc(var(--radius) - 2px)",
          "radius-lg": "var(--radius)",
          "radius-xl": "calc(var(--radius) + 4px)",
          "font-sans": "\"Inter\", -apple-system, BlinkMacSystemFont, ui-sans-serif, system-ui, sans-serif",
          "font-mono": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
          "color-success": "var(--success)",
          "color-success-foreground": "var(--success-foreground)",
          "color-warning": "var(--warning)",
          "color-warning-foreground": "var(--warning-foreground)",
          "color-destructive-foreground": "var(--destructive-foreground)",
          "shadow-glass": "var(--glass-shadow)"
        },
        "light": {
          "background": "#ffffff",
          "foreground": "#0f1420",
          "card": "#ffffff",
          "card-foreground": "#0f1420",
          "popover": "#ffffff",
          "popover-foreground": "#0f1420",
          "primary": "#1d4ed8",
          "primary-foreground": "#ffffff",
          "secondary": "#f1f3f7",
          "secondary-foreground": "#141a26",
          "muted": "#f1f3f7",
          "muted-foreground": "#5a6475",
          "accent": "#e6edfb",
          "accent-foreground": "#132a63",
          "highlight": "#f7c51e",
          "highlight-foreground": "#241a00",
          "emphasis": "#c8231a",
          "emphasis-foreground": "#ffffff",
          "destructive": "#c8231a",
          "destructive-foreground": "#ffffff",
          "success": "#13734a",
          "success-foreground": "#ffffff",
          "warning": "#a35a00",
          "warning-foreground": "#ffffff",
          "border": "#dde2ea",
          "input": "#838c9c",
          "ring": "#1d4ed8",
          "glass": "#ffffff99",
          "glass-strong": "#ffffffe3",
          "glass-clear": "#ffffff1f",
          "glass-dim": "#00000080",
          "glass-clear-foreground": "#ffffff",
          "glass-border": "#ffffffb3",
          "glass-solid": "#f7f8fa",
          "glass-clear-solid": "#0f1420",
          "chart-1": "#1d4ed8",
          "chart-2": "#c8231a",
          "chart-3": "#c99400",
          "chart-4": "#7a52b3",
          "chart-5": "#5f6878",
          "sidebar": "#f7f8fa",
          "sidebar-foreground": "#0f1420",
          "sidebar-primary": "#1d4ed8",
          "sidebar-primary-foreground": "#ffffff",
          "sidebar-accent": "#e6edfb",
          "sidebar-accent-foreground": "#132a63",
          "sidebar-border": "#dde2ea",
          "sidebar-ring": "#1d4ed8",
          "radius": "0.5rem",
          "glass-shadow": "inset 0 1px 0 0 #ffffffe6, inset 0 -1px 0 0 #ffffff40, inset 0 0 0 1px #ffffff59, 0 1px 2px 0 #0d16150f, 0 10px 30px -10px #0d161538",
          "glass-blur": "24px"
        },
        "dark": {
          "background": "#0a0d14",
          "foreground": "#e7eaf0",
          "card": "#10141c",
          "card-foreground": "#e7eaf0",
          "popover": "#10141c",
          "popover-foreground": "#e7eaf0",
          "primary": "#7aa2ff",
          "primary-foreground": "#0a1433",
          "secondary": "#1a202b",
          "secondary-foreground": "#e7eaf0",
          "muted": "#1a202b",
          "muted-foreground": "#98a1b2",
          "accent": "#18264a",
          "accent-foreground": "#c9d8fb",
          "highlight": "#ffd84d",
          "highlight-foreground": "#241a00",
          "emphasis": "#ff7a6b",
          "emphasis-foreground": "#2a0804",
          "destructive": "#ff7a6b",
          "destructive-foreground": "#2a0804",
          "success": "#4cc38a",
          "success-foreground": "#03200f",
          "warning": "#f0a54a",
          "warning-foreground": "#2a1600",
          "border": "#252c39",
          "input": "#5c6880",
          "ring": "#7aa2ff",
          "glass": "#161b2599",
          "glass-strong": "#161b25e6",
          "glass-clear": "#ffffff1f",
          "glass-dim": "#00000080",
          "glass-clear-foreground": "#ffffff",
          "glass-border": "#ffffff24",
          "glass-solid": "#161b25",
          "glass-clear-solid": "#0f1420",
          "chart-1": "#7aa2ff",
          "chart-2": "#ff7a6b",
          "chart-3": "#ffd84d",
          "chart-4": "#b08ae0",
          "chart-5": "#a3abb9",
          "sidebar": "#0d1118",
          "sidebar-foreground": "#e7eaf0",
          "sidebar-primary": "#7aa2ff",
          "sidebar-primary-foreground": "#0a1433",
          "sidebar-accent": "#18264a",
          "sidebar-accent-foreground": "#c9d8fb",
          "sidebar-border": "#252c39",
          "sidebar-ring": "#7aa2ff",
          "glass-shadow": "inset 0 1px 0 0 #ffffff38, inset 0 -1px 0 0 #ffffff0d, inset 0 0 0 1px #ffffff1a, 0 1px 2px 0 #00000066, 0 10px 30px -10px #000000a6"
        }
      }
    },
