{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "uiuiui",
  "homepage": "https://aline-aroucha.github.io/uiuiui",
  "items": [
    {
      "name": "style",
      "type": "registry:style",
      "extends": "none",
      "title": "UIUIUI",
      "description": "The UIUIUI base: tokens (light and dark colors, radius, fonts), base styles and the cn() helper.",
      "dependencies": [
        "tw-animate-css",
        "clsx",
        "tailwind-merge",
        "@heroicons/react",
        "class-variance-authority"
      ],
      "registryDependencies": [
        "https://aline-aroucha.github.io/uiuiui/r/utils.json"
      ],
      "css": {
        "@import \"tw-animate-css\"": {},
        "@custom-variant dark (&:is(.dark *))": {},
        "@layer base": {
          "*": {
            "@apply border-border outline-ring/50": {}
          },
          "body": {
            "@apply bg-background text-foreground font-sans antialiased": {}
          }
        },
        "@utility glass": {
          "background-color": "var(--glass)",
          "-webkit-backdrop-filter": "blur(var(--glass-blur)) saturate(200%)",
          "backdrop-filter": "blur(var(--glass-blur)) saturate(200%)",
          "@media (prefers-reduced-transparency: reduce), (prefers-contrast: more)": {
            "background-color": "var(--glass-solid)",
            "-webkit-backdrop-filter": "none",
            "backdrop-filter": "none"
          }
        },
        "@utility glass-strong": {
          "background-color": "var(--glass-strong)",
          "-webkit-backdrop-filter": "blur(var(--glass-blur)) saturate(200%)",
          "backdrop-filter": "blur(var(--glass-blur)) saturate(200%)",
          "@media (prefers-reduced-transparency: reduce), (prefers-contrast: more)": {
            "background-color": "var(--glass-solid)",
            "-webkit-backdrop-filter": "none",
            "backdrop-filter": "none"
          }
        },
        "@utility glass-clear": {
          "background-color": "var(--glass-clear)",
          "color": "var(--glass-clear-foreground)",
          "-webkit-backdrop-filter": "blur(var(--glass-blur)) saturate(200%)",
          "backdrop-filter": "blur(var(--glass-blur)) saturate(200%)",
          "@media (prefers-reduced-transparency: reduce), (prefers-contrast: more)": {
            "background-color": "var(--glass-clear-solid)",
            "-webkit-backdrop-filter": "none",
            "backdrop-filter": "none"
          }
        },
        "@utility scroll-edge": {
          "mask-image": "linear-gradient(to bottom, transparent, black 24px, black calc(100% - 24px), transparent)"
        }
      },
      "cssVars": {
        "theme": {
          "radius-sm": "calc(var(--radius) - 4px)",
          "radius-md": "calc(var(--radius) - 2px)",
          "radius-lg": "var(--radius)",
          "radius-xl": "calc(var(--radius) + 4px)",
          "font-sans": "\"Inter\", -apple-system, BlinkMacSystemFont, ui-sans-serif, system-ui, sans-serif",
          "font-mono": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
          "color-success": "var(--success)",
          "color-success-foreground": "var(--success-foreground)",
          "color-warning": "var(--warning)",
          "color-warning-foreground": "var(--warning-foreground)",
          "color-destructive-foreground": "var(--destructive-foreground)",
          "shadow-glass": "var(--glass-shadow)"
        },
        "light": {
          "background": "#ffffff",
          "foreground": "#0d1615",
          "card": "#ffffff",
          "card-foreground": "#0d1615",
          "popover": "#ffffff",
          "popover-foreground": "#0d1615",
          "primary": "#0b6b60",
          "primary-foreground": "#f3fbf9",
          "secondary": "#f0f4f3",
          "secondary-foreground": "#14211f",
          "muted": "#f0f4f3",
          "muted-foreground": "#576865",
          "accent": "#e3f1ee",
          "accent-foreground": "#0e3c36",
          "destructive": "#c8321f",
          "destructive-foreground": "#ffffff",
          "success": "#13734a",
          "success-foreground": "#ffffff",
          "warning": "#a35a00",
          "warning-foreground": "#ffffff",
          "border": "#dce4e2",
          "input": "#82928e",
          "ring": "#0b6b60",
          "glass": "#ffffff99",
          "glass-strong": "#ffffffe3",
          "glass-clear": "#ffffff1f",
          "glass-dim": "#00000080",
          "glass-clear-foreground": "#ffffff",
          "glass-border": "#ffffffb3",
          "glass-solid": "#f7f9f9",
          "glass-clear-solid": "#0d1615",
          "chart-1": "#0b6b60",
          "chart-2": "#2f74b5",
          "chart-3": "#c9821f",
          "chart-4": "#7a52b3",
          "chart-5": "#5b6b68",
          "sidebar": "#f7f9f9",
          "sidebar-foreground": "#0d1615",
          "sidebar-primary": "#0b6b60",
          "sidebar-primary-foreground": "#f3fbf9",
          "sidebar-accent": "#e3f1ee",
          "sidebar-accent-foreground": "#0e3c36",
          "sidebar-border": "#dce4e2",
          "sidebar-ring": "#0b6b60",
          "radius": "0.5rem",
          "glass-shadow": "inset 0 1px 0 0 #ffffffe6, inset 0 -1px 0 0 #ffffff40, inset 0 0 0 1px #ffffff59, 0 1px 2px 0 #0d16150f, 0 10px 30px -10px #0d161538",
          "glass-blur": "24px"
        },
        "dark": {
          "background": "#0a1110",
          "foreground": "#e6eeec",
          "card": "#101918",
          "card-foreground": "#e6eeec",
          "popover": "#101918",
          "popover-foreground": "#e6eeec",
          "primary": "#45c4b0",
          "primary-foreground": "#032019",
          "secondary": "#1a2624",
          "secondary-foreground": "#e6eeec",
          "muted": "#1a2624",
          "muted-foreground": "#93a5a1",
          "accent": "#16302c",
          "accent-foreground": "#c3ebe3",
          "destructive": "#f0715f",
          "destructive-foreground": "#2a0804",
          "success": "#4cc38a",
          "success-foreground": "#03200f",
          "warning": "#f0a54a",
          "warning-foreground": "#2a1600",
          "border": "#24332f",
          "input": "#56706b",
          "ring": "#45c4b0",
          "glass": "#16211f99",
          "glass-strong": "#16211fe6",
          "glass-clear": "#ffffff1f",
          "glass-dim": "#00000080",
          "glass-clear-foreground": "#ffffff",
          "glass-border": "#ffffff24",
          "glass-solid": "#16211f",
          "glass-clear-solid": "#0d1615",
          "chart-1": "#45c4b0",
          "chart-2": "#6aa9e6",
          "chart-3": "#f0b257",
          "chart-4": "#b08ae0",
          "chart-5": "#a3b3af",
          "sidebar": "#0d1514",
          "sidebar-foreground": "#e6eeec",
          "sidebar-primary": "#45c4b0",
          "sidebar-primary-foreground": "#032019",
          "sidebar-accent": "#16302c",
          "sidebar-accent-foreground": "#c3ebe3",
          "sidebar-border": "#24332f",
          "sidebar-ring": "#45c4b0",
          "glass-shadow": "inset 0 1px 0 0 #ffffff38, inset 0 -1px 0 0 #ffffff0d, inset 0 0 0 1px #ffffff1a, 0 1px 2px 0 #00000066, 0 10px 30px -10px #000000a6"
        }
      }
    },
